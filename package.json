{
  "name": "guess-the-radionuclide",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A multilingual, evidence-based radionuclide deduction game by Michele Colucci",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:multiplayer": "node --test tests/multiplayer.test.mjs tests/multiplayer-recovery.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-radionuclide --only database,auth \"node --test tests/multiplayer.rules.mjs\"",
    "test:online": "firebase emulators:exec --project demo-radionuclide --only database,auth \"node tests/browser-online.mjs\"",
    "rules:generate": "node scripts/multiplayer-rules.mjs",
    "train": "node scripts/train-intents.mjs",
    "data:refresh": "python3 scripts/import_iaea.py",
    "verify": "npm test && npm run build",
    "train:llm:prepare": "node scripts/prepare-llm.mjs",
    "data:curate": "python3 scripts/curate_data.py",
    "test:llm": "node tests/browser-llm.mjs",
    "test:learning": "node --test tests/learning.test.mjs",
    "test:learning:e2e": "node tests/browser-learning.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.79",
    "firebase": "^12.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.55.1",
    "acorn": "8.15.0",
    "esbuild": "0.25.10",
    "firebase-tools": "^14.17.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
